{
  "manifest_version": 3,
  "name": "Façonote → D365",
  "short_name": "Façonote D365",
  "version": "0.4.4",
  "description": "Reçoit les envois de Façonote et pré-remplit D365 F&O : DEV de la commande et quantités de bobines de la nomenclature.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://faconote.jokinesse.be/*"],
      "js": ["common.js", "faconote.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://facozinc-prod.operations.fr.dynamics.com/*"],
      "js": ["common.js", "d365.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
